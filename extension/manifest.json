{
  "manifest_version": 3,
  "name": "CLEAR",
  "version": "0.1.0",
  "description": "Content and Listing Evaluation for Abuse Reduction",
  "action": {
    "default_title": "CLEAR"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://*.craigslist.org/*",
        "https://*.offerup.com/*",
        "https://www.ebay.com/itm/*",
        "https://*.reverb.com/item/*",
        "https://www.mercari.com/us/item/*",
        "https://nextdoor.com/*",
        "https://*.etsy.com/listing/*",
        "https://*.poshmark.com/listing/*",
        "https://*.depop.com/products/*",
        "https://*.vinted.com/items/*",
        "https://*.grailed.com/listings/*",
        "https://*.swappa.com/listing/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
